# AI Codebase Context Assistant local environment example
#
# Copy this file to .env when runtime configuration needs environment values.
# The current deterministic MVP does not require an LLM key to run tests,
# index a repository, ask grounded deterministic questions, or check drift.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------

# local is the intended default for this project.
CODE_CONTEXT_ENV=local

# ---------------------------------------------------------------------------
# Local index settings
# ---------------------------------------------------------------------------

# Default local index directory used by examples and future config wiring.
CODE_CONTEXT_INDEX_DIR=.code_context_index

# Default JSON index filename.
CODE_CONTEXT_INDEX_FILENAME=code_context_index.json

# ---------------------------------------------------------------------------
# Future LLM provider settings
# ---------------------------------------------------------------------------

# The current project does not call an LLM yet.
# These values are reserved for a future LLM slice after grounding,
# verification, stale-index refusal, and citations are already protected.

LLM_PROVIDER=openai
OPENAI_API_KEY=

# Example future model setting.
# Keep this configurable so the project is not hardcoded to one model.
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Future embedding/vector settings
# ---------------------------------------------------------------------------

# The current project uses deterministic local vector-style retrieval.
# ChromaDB and provider-backed embeddings are future improvements.

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Example future Chroma path.
CHROMA_PERSIST_DIR=.chroma

# ---------------------------------------------------------------------------
# API settings
# ---------------------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=8000