# AI Codebase Context Assistant local environment example
#
# Copy this file to .env when runtime configuration needs environment values.
# The deterministic workflow does not require an LLM key to run tests,
# index a repository, ask grounded deterministic questions, or check drift.
# Generated answers are optional and require provider configuration.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------

# local is the intended default for this project.
CODE_CONTEXT_ENV=local

# ---------------------------------------------------------------------------
# Local index settings
# ---------------------------------------------------------------------------

# Default local index directory used by examples and runtime config.
CODE_CONTEXT_INDEX_DIR=.code_context_index

# Default JSON index filename.
CODE_CONTEXT_INDEX_FILENAME=code_context_index.json

# ---------------------------------------------------------------------------
# Optional LLM provider settings
# ---------------------------------------------------------------------------

# Generated answers are optional.
# They run only after stale-index checks, grounded retrieval,
# sufficiency verification, and citation grounding are already protected.

LLM_PROVIDER=openai
OPENAI_API_KEY=

# Optional configured default model.
# CLI and API ask requests can override this per request with
# --llm-model or llm_model.
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Future embedding/vector settings
# ---------------------------------------------------------------------------

# The current project uses deterministic local vector-style retrieval.
# ChromaDB and provider-backed embeddings are future improvements.

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Example future Chroma path.
CHROMA_PERSIST_DIR=.chroma

# ---------------------------------------------------------------------------
# API settings
# ---------------------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=8000
