# AI Codebase Context Assistant local environment example
#
# Copy this file to .env when runtime configuration needs environment values.
# Do not commit .env or real API keys.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------

# local is the intended default for this project.
CODE_CONTEXT_ENV=local

# ---------------------------------------------------------------------------
# Local index settings
# ---------------------------------------------------------------------------

# Default local index directory used by examples and runtime config.
CODE_CONTEXT_INDEX_DIR=.code_context_index

# Default JSON index filename.
CODE_CONTEXT_INDEX_FILENAME=code_context_index.json

# ---------------------------------------------------------------------------
# Optional LLM provider settings
# ---------------------------------------------------------------------------

# Deterministic indexing, retrieval, stale-index checks, and deterministic ask
# commands work without an LLM provider.
#
# Set these values only when you want optional generated answers after
# stale-index and grounding checks pass.

LLM_PROVIDER=openai
OPENAI_API_KEY=

# Keep this configurable so the project is not hardcoded to one model.
OPENAI_MODEL=gpt-4.1-mini

# ---------------------------------------------------------------------------
# Future embedding/vector settings
# ---------------------------------------------------------------------------

# The current project uses deterministic local vector-style retrieval.
# ChromaDB and provider-backed embeddings are future improvements.

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Example future Chroma path.
CHROMA_PERSIST_DIR=.chroma

# ---------------------------------------------------------------------------
# API settings
# ---------------------------------------------------------------------------

API_HOST=127.0.0.1
API_PORT=8000
